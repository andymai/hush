  <name>Hush</name>
  <summary>Dictate into any app, locally</summary>
  <developer id="io.github.andymai">
    <name>Andy Aragon</name>
  </developer>

  <description>
    <p>
      Hush turns speech into text on the Linux desktop. Hold a key, speak, and
      let go: the words appear at the cursor. Hush runs OpenAI's Whisper models
      or NVIDIA's Parakeet on your computer, on the GPU through Vulkan when one
      is present, so your audio stays on your computer.
    </p>
    <ul>
      <li>Hold to talk, or tap twice for hands-free recording that transcribes in parts while you speak</li>
      <li>Any language that Whisper knows, with an optional key for each language</li>
      <li>Text that fits the application: casual in chat, full sentences in mail, no line breaks in a terminal</li>
      <li>Your own words: teach Hush a name once, and it spells the name your way</li>
      <li>Optional polish of the text by a local or cloud language model, which gets text and never audio</li>
      <li>A history of your transcripts that only you can read, and recovery of a failed take</li>
      <li>A settings window and a panel icon</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.andymai.hush.desktop</launchable>
  <provides>
    <binary>hush</binary>
  </provides>

  <url type="homepage">https://github.com/andymai/hush</url>
  <url type="bugtracker">https://github.com/andymai/hush/issues</url>
  <url type="vcs-browser">https://github.com/andymai/hush</url>

  <content_rating type="oars-1.1"/>

  <branding>
    <color type="primary" scheme_preference="light">#d7d2fa</color>
    <color type="primary" scheme_preference="dark">#2e2670</color>
