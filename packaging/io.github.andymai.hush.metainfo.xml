  <content_rating type="oars-1.1"/>

  <branding>
    <color type="primary" scheme_preference="light">#ffd47a</color>
    <color type="primary" scheme_preference="dark">#4f3608</color>
  </branding>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <requires>
