# Maintainer: Andy Aragon <hi@andymai.com>
# Generated by the release workflow from packaging/aur/PKGBUILD.template.
pkgname=hush-voice-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Local voice-to-text for Linux desktops: hold a key, speak, and the text appears at your cursor"
arch=('x86_64')
url="https://github.com/andymai/hush"
license=('MIT')
# The GUI libraries from libglvnd down are loaded with dlopen, so namcap does not see them.
depends=(
  'glibc' 'libgcc' 'libstdc++' 'alsa-lib' 'vulkan-icd-loader' 'libx11' 'hicolor-icon-theme'
  'libglvnd' 'wayland' 'libxkbcommon' 'libxkbcommon-x11'
  'libxcb' 'libxcursor' 'libxext' 'libxi' 'libxinerama' 'libxrandr' 'libxrender' 'libxxf86vm'
)
# These AUR packages are other programs that also install /usr/bin/hush.
conflicts=('hush' 'hush-bin' 'hush-git' 'hush-shell')
# Ship the release binary unchanged, with its symbols, and make no -debug package.
options=('!strip' '!debug')
source=("https://github.com/andymai/hush/releases/download/v${pkgver}/hush-${pkgver}-x86_64-linux.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "hush-${pkgver}-x86_64-linux"
  install -Dm755 bin/hush "$pkgdir/usr/bin/hush"
  # libtranscribe and the ggml backend modules, private to Hush: the binary's
  # RUNPATH is $ORIGIN/../lib/hush.
  install -d "$pkgdir/usr/lib/hush"
  install -m644 lib/hush/* "$pkgdir/usr/lib/hush/"
  install -Dm644 io.github.andymai.hush.desktop "$pkgdir/usr/share/applications/io.github.andymai.hush.desktop"
  install -Dm644 io.github.andymai.hush.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.andymai.hush.svg"
  install -Dm644 70-hush.rules "$pkgdir/usr/lib/udev/rules.d/70-hush.rules"
  install -Dm644 hush.service "$pkgdir/usr/lib/systemd/user/hush.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
