# Hush Configuration - Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key (for Claude-powered text polishing)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: OpenAI API Key (alternative LLM provider)
# OPENAI_API_KEY=sk-your-key-here

# Optional: Custom API endpoint for self-hosted models
# LLM_API_ENDPOINT=http://localhost:8080/v1
