# Hush API keys. Copy this file to ~/.config/hush/.env and keep the keys you
# use. Hush also reads ./.env in a source checkout. A variable that you set in
# the environment wins over this file.

# Anthropic: the LLM for polish and Command Mode (llm.provider "auto" or "anthropic")
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Groq: cloud transcription (transcription.backend "groq")
# GROQ_API_KEY=gsk_your-key-here

# OpenAI: cloud transcription (transcription.backend "openai")
# OPENAI_API_KEY=sk-your-key-here

# Your own server: name the variable in transcription.server_key_env or
# llm.server_key_env, and set that variable here
# MY_SERVER_KEY=your-key-here
