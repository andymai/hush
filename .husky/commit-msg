#!/usr/bin/env bash

# A missing commitlint skips the check. A message that commitlint rejects
# stops the commit.
if ! npx --no -- commitlint --version >/dev/null 2>&1; then
  echo "commitlint is not available, skipping the commit message check."
  echo "Run 'npm install' to enable conventional commit enforcement."
  exit 0
fi
exec npx --no -- commitlint --edit "$1"
