#!/usr/bin/env bash
# Hush Voice-to-Text - Convenient Start Script
# This script provides easy access to Hush functionality with smart defaults

set -euo pipefail

# Script configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HUSH_BINARY="cargo run --bin hush-unified --"
QUIET_MODE=false
VERBOSE_MODE=false

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color

# Emoji support check
if locale | grep -q "UTF-8"; then
    EMOJI_SUPPORT=true
else
    EMOJI_SUPPORT=false
fi

# Helper functions
print_header() {
    if [[ "$EMOJI_SUPPORT" == true ]]; then
        echo -e "${PURPLE}🤫 Hush - Voice-to-Text for Linux Developers${NC}"
    else
        echo -e "${PURPLE}Hush - Voice-to-Text for Linux Developers${NC}"
    fi
}

print_success() {
    local msg="$1"
    if [[ "$EMOJI_SUPPORT" == true ]]; then
        echo -e "${GREEN}✅ ${msg}${NC}"
    else
        echo -e "${GREEN}[OK] ${msg}${NC}"
    fi
}

print_error() {
    local msg="$1"
    if [[ "$EMOJI_SUPPORT" == true ]]; then
        echo -e "${RED}❌ ${msg}${NC}"
    else
        echo -e "${RED}[ERROR] ${msg}${NC}"
    fi
}

print_warning() {
    local msg="$1"
    if [[ "$EMOJI_SUPPORT" == true ]]; then
        echo -e "${YELLOW}⚠️  ${msg}${NC}"
    else
        echo -e "${YELLOW}[WARNING] ${msg}${NC}"
    fi
}

print_info() {
    local msg="$1"
    if [[ "$EMOJI_SUPPORT" == true ]]; then
        echo -e "${CYAN}ℹ️  ${msg}${NC}"
    else
        echo -e "${CYAN}[INFO] ${msg}${NC}"
    fi
}

print_usage() {
    print_header
    echo
    echo "A convenient wrapper script for Hush voice-to-text functionality."
    echo
    echo -e "${WHITE}Usage:${NC}"
    echo "  ./hush [command] [options]"
    echo
    echo -e "${WHITE}Quick Commands:${NC}"
    echo "  ./hush                     Start with TUI interface (default)"
    echo "  ./hush start               Start with TUI interface"
    echo "  ./hush record              Record once and exit"
    echo "  ./hush setup               Run setup wizard"
    echo "  ./hush status              Show system status"
    echo
    echo -e "${WHITE}Setup Commands:${NC}"
    echo "  ./hush setup uinput        Show UInput setup guide"
    echo "  ./hush setup wizard        Run complete setup wizard"
    echo "  ./hush setup audio --list  List audio devices"
    echo
    echo -e "${WHITE}Testing Commands:${NC}"
    echo "  ./hush test all            Run all system tests"
    echo "  ./hush test audio          Test audio capture"
    echo "  ./hush test hotkeys        Test hotkey system"
    echo "  ./hush test pipeline       Test complete pipeline"
    echo
    echo -e "${WHITE}Model Commands:${NC}"
    echo "  ./hush models list         List available models"
    echo "  ./hush models download base  Download base model"
    echo "  ./hush models info         Show model cache info"
    echo
    echo -e "${WHITE}Options:${NC}"
    echo "  -h, --help                 Show this help message"
    echo "  -v, --verbose              Enable verbose logging"
    echo "  -q, --quiet               Minimize output"
    echo "  --no-notifications        Disable desktop notifications"
    echo "  --config PATH             Use custom config file"
    echo
    echo -e "${WHITE}Start Modes:${NC}"
    echo "  ./hush start               TUI interface (default)"
    echo "  ./hush start --cli         CLI/hotkey mode (legacy)"
    echo "  ./hush cli                 Shortcut for CLI mode"
    echo
    echo -e "${WHITE}Environment Setup:${NC}"
    echo "  First time setup:"
    echo "    1. ./hush models download base"
    echo "    2. ./hush setup wizard"
    echo "    3. ./hush start"
    echo
}

# Check if Rust/Cargo is available
check_rust() {
    if ! command -v cargo &> /dev/null; then
        print_error "Cargo (Rust package manager) not found!"
        echo "Please install Rust: https://rustup.rs/"
        exit 1
    fi
}

# Check if we're in the right directory
check_environment() {
    if [[ ! -f "Cargo.toml" ]]; then
        print_error "Cargo.toml not found. Please run this script from the Hush project directory."
        exit 1
    fi
    
    if [[ ! -f "src/main_new.rs" ]]; then
        print_error "src/main_new.rs not found. The new CLI system may not be set up yet."
        echo "Please run: cargo build --bin hush-unified"
        exit 1
    fi
}

# Smart command defaults and shortcuts
process_command() {
    local args=("$@")
    
    # Handle empty command (default to start)
    if [[ ${#args[@]} -eq 0 ]]; then
        args=("start")
    fi
    
    # Handle shortcuts and smart defaults
    case "${args[0]}" in
        "help" | "-h" | "--help")
            print_usage
            exit 0
            ;;
        "start" | "run" | "daemon")
            # Default start command
            if [[ ${#args[@]} -eq 1 ]]; then
                args=("start")
            fi
            ;;
        "record" | "once")
            # Single recording
            if [[ ${#args[@]} -eq 1 ]]; then
                args=("record")
            fi
            ;;
        "setup")
            # Smart setup defaults
            if [[ ${#args[@]} -eq 1 ]]; then
                args=("setup" "wizard")
            fi
            ;;
        "test")
            # Smart test defaults
            if [[ ${#args[@]} -eq 1 ]]; then
                args=("test" "all")
            fi
            ;;
        "models" | "model")
            # Smart model defaults
            if [[ ${#args[@]} -eq 1 ]]; then
                args=("models" "list")
            fi
            ;;
        "status" | "info")
            args=("status" "--full")
            ;;
        # Direct binary commands (shortcuts)
        "tui")
            # TUI is now default, so just use start
            args=("start")
            ;;
        "cli")
            # CLI/hotkey mode
            args=("start" "--cli")
            ;;
        "manual")
            args=("manual")
            ;;
        *)
            # Pass through unknown commands as-is
            ;;
    esac
    
    echo "${args[@]}"
}

# Build verbose flags
build_verbosity_flags() {
    local flags=()
    
    if [[ "$VERBOSE_MODE" == true ]]; then
        flags+=("-vvv")
    elif [[ "$QUIET_MODE" == true ]]; then
        # Quiet mode - minimal logging
        flags+=()
    else
        # Default verbosity
        flags+=("-v")
    fi
    
    echo "${flags[@]}"
}

# First-time setup check
check_first_time_setup() {
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hush/models"
    local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hush"
    
    # Check if models exist
    local has_models=false
    if [[ -d "$cache_dir" ]] && [[ -n "$(ls -A "$cache_dir" 2>/dev/null)" ]]; then
        has_models=true
    fi
    
    # Check if config exists
    local has_config=false
    if [[ -f "$config_dir/config.toml" ]] || [[ -f "config/default.toml" ]]; then
        has_config=true
    fi
    
    # Show first-time setup message
    if [[ "$has_models" == false ]] && [[ "$QUIET_MODE" == false ]]; then
        print_info "First time setup detected!"
        echo "Recommended setup steps:"
        echo "  1. Download a model: ./hush models download base"
        echo "  2. Run setup wizard: ./hush setup wizard"
        echo "  3. Test systems: ./hush test all"
        echo
        echo "Or run the complete setup wizard: ./hush setup wizard"
        echo
        
        # Ask if user wants to run setup wizard
        if [[ -t 0 ]]; then  # Only ask if stdin is a terminal
            echo -n "Would you like to run the setup wizard now? (y/N): "
            read -r response
            if [[ "$response" =~ ^[Yy]$ ]]; then
                exec ./hush setup wizard
            fi
        fi
    fi
}

# Process global options
process_global_options() {
    local processed_args=()
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                print_usage
                exit 0
                ;;
            -v|--verbose)
                VERBOSE_MODE=true
                shift
                ;;
            -q|--quiet)
                QUIET_MODE=true
                shift
                ;;
            --no-notifications)
                processed_args+=("--no-notifications")
                shift
                ;;
            --config)
                processed_args+=("--config" "$2")
                shift 2
                ;;
            *)
                processed_args+=("$1")
                shift
                ;;
        esac
    done
    
    echo "${processed_args[@]}"
}

# Main execution
main() {
    # Process global options first
    local remaining_args
    remaining_args=($(process_global_options "$@"))
    
    # Check environment
    if [[ "$QUIET_MODE" == false ]]; then
        print_header
        echo
    fi
    
    check_rust
    check_environment
    
    # Process command with smart defaults
    local final_args
    final_args=($(process_command "${remaining_args[@]}"))
    
    # Add verbosity flags
    local verbosity_flags
    verbosity_flags=($(build_verbosity_flags))
    
    # First-time setup check (only for start commands)
    if [[ "${final_args[0]}" == "start" ]] || [[ "${final_args[0]}" == "record" ]]; then
        check_first_time_setup
    fi
    
    # Build final command
    local cmd=()
    cmd+=($HUSH_BINARY)
    cmd+=("${verbosity_flags[@]}")
    cmd+=("${final_args[@]}")
    
    # Execute command
    if [[ "$VERBOSE_MODE" == true ]]; then
        print_info "Executing: ${cmd[*]}"
        echo
    fi
    
    cd "$SCRIPT_DIR"
    exec "${cmd[@]}"
}

# Handle script interruption
trap 'echo; print_info "Interrupted by user"; exit 130' INT

# Run main function with all arguments
main "$@"