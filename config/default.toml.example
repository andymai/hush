# Hush Default Configuration
# Copy this file to config/default.toml and customize as needed

[audio]
sample_rate = 16000
channels = 1
buffer_size = 1024

[transcription]
# Model path - defaults to ~/.cache/hush/models/ if not specified
# model_path = "~/.cache/hush/models/ggml-base.en.bin"
model_size = "base"  # Options: tiny, base, small, medium, large
language = "en"
use_cuda = true
beam_size = 5
no_speech_threshold = 0.6

[hotkey]
enabled = true
combination = "Ctrl+Shift+Space"

[feedback]
audio_enabled = false

[overlay]
# theme = "dark"  # Options: dark, light
# show_button_when_idle = false
